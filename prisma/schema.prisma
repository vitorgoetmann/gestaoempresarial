generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AccessAction {
  LOGIN
  LOGOUT
  FAILED_LOGIN
  PASSWORD_RESET
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  LOSS
  RETURN
  TRANSFER
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum FinancialEntryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  QUALIFIED
  DISQUALIFIED
  WON
  LOST
}

enum OpportunityStage {
  PROSPECT
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SYSTEM
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  industry  String?
  timezone  String?
  locale    String?
  ownerId   String?      @map("owner_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  owner                 User?                  @relation("TenantOwner", fields: [ownerId], references: [id])
  memberships           Membership[]
  sessions              Session[]
  accessLogs            AccessLog[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  customers             Customer[]
  productCategories     ProductCategory[]
  brands                Brand[]
  suppliers             Supplier[]
  products              Product[]
  inventoryMoves        InventoryMovement[]
  sales                 Sale[]
  financialAccounts     FinancialAccount[]
  financialCategories   FinancialCategory[]
  financialTransactions FinancialTransaction[]
  tasks                 Task[]
  leads                 Lead[]
  contacts              Contact[]
  opportunities         Opportunity[]
  interactions          Interaction[]
  aiRequests            AiRequest[]

  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  email           String     @unique
  phone           String?
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  memberships        Membership[]
  sessions           Session[]
  accessLogs         AccessLog[]
  auditLogs          AuditLog[]
  ownedTenants       Tenant[]                 @relation("TenantOwner")
  createdTasks       Task[]                   @relation("TaskCreator")
  assignedTasks      Task[]                   @relation("TaskAssignee")
  taskComments       TaskComment[]
  notifications      Notification[]
  aiRequests         AiRequest[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  inventoryMovements InventoryMovement[]
  interactions       Interaction[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole   @default(STAFF)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([status])
  @@index([deletedAt])
  @@map("memberships")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, tenantId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model AccessLog {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String?      @map("tenant_id") @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  action    AccessAction
  success   Boolean      @default(true)
  ipAddress String?      @map("ip_address")
  userAgent String?      @map("user_agent")
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
  @@map("access_logs")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  module    String
  action    String
  entity    String
  entityId  String?   @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([module])
  @@index([deletedAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_verification_tokens")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String
  document       String?   @map("document")
  phone          String?
  whatsapp       String?
  email          String?
  postalCode     String?   @map("postal_code")
  addressLine    String?   @map("address_line")
  city           String?
  state          String?
  country        String?
  notes          String?
  lastPurchaseAt DateTime? @map("last_purchase_at")
  totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  totalOrders    Int       @default(0) @map("total_orders")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  sales                 Sale[]
  financialTransactions FinancialTransaction[]

  @@unique([tenantId, document])
  @@index([tenantId])
  @@index([email])
  @@index([deletedAt])
  @@map("customers")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("product_categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("brands")
}

model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("suppliers")
}

model Product {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  categoryId   String?   @map("category_id") @db.Uuid
  brandId      String?   @map("brand_id") @db.Uuid
  supplierId   String?   @map("supplier_id") @db.Uuid
  sku          String?   @map("sku")
  barcode      String?   @map("barcode")
  name         String
  description  String?
  costPrice    Decimal   @default(0) @map("cost_price") @db.Decimal(12, 2)
  salePrice    Decimal   @default(0) @map("sale_price") @db.Decimal(12, 2)
  margin       Decimal   @default(0) @map("margin") @db.Decimal(12, 2)
  stockCurrent Int       @default(0) @map("stock_current")
  stockMin     Int       @default(0) @map("stock_min")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  category       ProductCategory?    @relation(fields: [categoryId], references: [id])
  brand          Brand?              @relation(fields: [brandId], references: [id])
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  images         ProductImage[]
  saleItems      SaleItem[]
  inventoryMoves InventoryMovement[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([sku])
  @@index([barcode])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  url       String
  isPrimary Boolean   @default(false) @map("is_primary")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model InventoryMovement {
  id         String                @id @default(uuid()) @db.Uuid
  tenantId   String                @map("tenant_id") @db.Uuid
  productId  String                @map("product_id") @db.Uuid
  userId     String?               @map("user_id") @db.Uuid
  type       InventoryMovementType
  quantity   Int
  reason     String?
  reference  String?
  occurredAt DateTime              @default(now()) @map("occurred_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deletedAt  DateTime?             @map("deleted_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([occurredAt])
  @@map("inventory_movements")
}

model Sale {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  customerId String?    @map("customer_id") @db.Uuid
  status     SaleStatus @default(CONFIRMED)
  subtotal   Decimal    @default(0) @db.Decimal(12, 2)
  discount   Decimal    @default(0) @db.Decimal(12, 2)
  tax        Decimal    @default(0) @db.Decimal(12, 2)
  total      Decimal    @default(0) @db.Decimal(12, 2)
  notes      String?
  saleDate   DateTime   @default(now()) @map("sale_date")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id])
  items                 SaleItem[]
  payments              SalePayment[]
  financialTransactions FinancialTransaction[]

  @@index([tenantId])
  @@index([saleDate])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id        String    @id @default(uuid()) @db.Uuid
  saleId    String    @map("sale_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal   @default(0) @map("unit_price") @db.Decimal(12, 2)
  total     Decimal   @default(0) @db.Decimal(12, 2)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model SalePayment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @map("sale_id") @db.Uuid
  amount    Decimal       @default(0) @db.Decimal(12, 2)
  method    String
  status    PaymentStatus @default(PENDING)
  dueDate   DateTime?     @map("due_date")
  paidAt    DateTime?     @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("sale_payments")
}

model FinancialAccount {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  type      String
  balance   Decimal   @default(0) @db.Decimal(12, 2)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  transactions FinancialTransaction[]

  @@index([tenantId])
  @@map("financial_accounts")
}

model FinancialCategory {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  name      String
  type      FinancialEntryType @default(EXPENSE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  deletedAt DateTime?          @map("deleted_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  transactions FinancialTransaction[]

  @@index([tenantId])
  @@map("financial_categories")
}

model FinancialTransaction {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  accountId   String?            @map("account_id") @db.Uuid
  categoryId  String?            @map("category_id") @db.Uuid
  customerId  String?            @map("customer_id") @db.Uuid
  saleId      String?            @map("sale_id") @db.Uuid
  type        FinancialEntryType
  amount      Decimal            @default(0) @db.Decimal(12, 2)
  description String?
  status      PaymentStatus      @default(PENDING)
  dueDate     DateTime?          @map("due_date")
  paidAt      DateTime?          @map("paid_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  account  FinancialAccount?  @relation(fields: [accountId], references: [id])
  category FinancialCategory? @relation(fields: [categoryId], references: [id])
  customer Customer?          @relation(fields: [customerId], references: [id])
  sale     Sale?              @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("financial_transactions")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  startDate   DateTime?    @map("start_date")
  completedAt DateTime?    @map("completed_at")
  creatorId   String       @map("creator_id") @db.Uuid
  assigneeId  String?      @map("assignee_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([tenantId])
  @@index([status])
  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  message   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  fileUrl   String    @map("file_url")
  fileName  String    @map("file_name")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("task_attachments")
}

model Lead {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  status    LeadStatus @default(NEW)
  source    String?
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  opportunities Opportunity[]
  interactions  Interaction[]

  @@index([tenantId])
  @@map("leads")
}

model Contact {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  position  String?
  company   String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  opportunities Opportunity[]
  interactions  Interaction[]

  @@index([tenantId])
  @@map("contacts")
}

model Opportunity {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  leadId          String?          @map("lead_id") @db.Uuid
  contactId       String?          @map("contact_id") @db.Uuid
  title           String
  value           Decimal          @default(0) @db.Decimal(12, 2)
  stage           OpportunityStage @default(PROSPECT)
  expectedCloseAt DateTime?        @map("expected_close_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  interactions Interaction[]

  @@index([tenantId])
  @@index([stage])
  @@map("opportunities")
}

model Interaction {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  opportunityId String?   @map("opportunity_id") @db.Uuid
  leadId        String?   @map("lead_id") @db.Uuid
  contactId     String?   @map("contact_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  type          String
  notes         String?
  occurredAt    DateTime  @default(now()) @map("occurred_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("interactions")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  type      NotificationType @default(INFO)
  title     String
  message   String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([readAt])
  @@map("notifications")
}

model AiRequest {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  provider     String
  model        String?
  prompt       String
  response     String?
  status       String    @default("SUCCESS")
  inputTokens  Int?      @map("input_tokens")
  outputTokens Int?      @map("output_tokens")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("ai_requests")
}
